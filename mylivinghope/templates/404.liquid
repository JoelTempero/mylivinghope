{% comment %}
  404 Template
{% endcomment %}

<div style="min-height: 60vh; display: flex; align-items: center; justify-content: center; text-align: center; padding: 4rem 2rem;">
  <div style="max-width: 500px;">
    <h1 style="font-size: 5rem; color: var(--forest-green); margin-bottom: 0.5rem;">404</h1>
    <h2 style="margin-bottom: 1.5rem;">Page Not Found</h2>
    <p style="margin-bottom: 2rem; color: var(--text-secondary);">The page you're looking for seems to have wandered off. But don't worry—even when we feel lost, we're never truly alone.</p>
    <a href="{{ routes.root_url }}" class="btn btn--primary">Return Home</a>
    
    <blockquote class="about__verse" style="margin-top: 3rem;">
      <p class="about__verse-text">"The Lord is my shepherd, I lack nothing."</p>
      <cite class="about__verse-cite">— Psalm 23:1</cite>
    </blockquote>
  </div>
</div>
