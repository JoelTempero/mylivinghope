{% comment %}
  Cart Template
{% endcomment %}

<div class="page-header">
  <div class="container">
    <h1>Your Cart</h1>
  </div>
</div>

<section class="section">
  <div class="container" style="max-width: 800px;">
    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post">
        {% for item in cart.items %}
          <div class="cart-item" style="display: flex; gap: 1.5rem; padding: 1.5rem 0; border-bottom: 1px solid var(--blush-light);">
            <div class="cart-item__image" style="width: 100px; height: 100px; border-radius: 8px; overflow: hidden;">
              <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title }}" style="width: 100%; height: 100%; object-fit: cover;">
            </div>
            <div class="cart-item__details" style="flex: 1;">
              <h3 style="margin-bottom: 0.5rem;"><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
              <p style="color: var(--forest-green); font-weight: 600;">{{ item.price | money }}</p>
              <div style="display: flex; align-items: center; gap: 1rem; margin-top: 0.5rem;">
                <label for="updates_{{ item.key }}" class="visually-hidden">Quantity</label>
                <input type="number" id="updates_{{ item.key }}" name="updates[]" value="{{ item.quantity }}" min="1" style="width: 60px; padding: 0.5rem; border: 2px solid var(--blush-light); border-radius: 8px;">
                <a href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity=0" style="color: var(--text-muted); font-size: 0.875rem;">Remove</a>
              </div>
            </div>
            <div class="cart-item__total" style="text-align: right;">
              <p style="font-family: var(--font-heading); font-weight: 700; font-size: 1.25rem;">{{ item.line_price | money }}</p>
            </div>
          </div>
        {% endfor %}

        <div style="display: flex; justify-content: space-between; align-items: center; padding: 2rem 0; border-bottom: 2px solid var(--charcoal);">
          <span style="font-size: 1.25rem; font-weight: 600;">Subtotal</span>
          <span style="font-family: var(--font-heading); font-size: 1.5rem; font-weight: 700;">{{ cart.total_price | money }}</span>
        </div>

        <p style="margin-top: 1rem; color: var(--text-muted); font-size: 0.9375rem;">Shipping and taxes calculated at checkout.</p>

        <div style="display: flex; gap: 1rem; margin-top: 2rem;">
          <button type="submit" name="update" class="btn btn--secondary">Update Cart</button>
          <button type="submit" name="checkout" class="btn btn--primary btn--large" style="flex: 1;">Checkout</button>
        </div>
      </form>
    {% else %}
      <div style="text-align: center; padding: 4rem 0;">
        <p style="font-size: 1.25rem; margin-bottom: 2rem;">Your cart is empty</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">Continue Shopping</a>
      </div>
    {% endif %}
  </div>
</section>
