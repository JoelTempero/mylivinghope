{% comment %}
  Testimonials Section
{% endcomment %}

<section class="section section--green" id="testimonials">
  <div class="container">
    <header class="section-header reveal">
      <span class="section-tag">{{ section.settings.tag | default: "Stories of Impact" }}</span>
      <h2>{{ section.settings.heading | default: "What People Are Saying" }}</h2>
      <p>{{ section.settings.description | default: "Lives transformed through deeper prayer" }}</p>
    </header>

    <div class="testimonials__grid">
      {% for block in section.blocks %}
        <blockquote class="testimonial reveal reveal--delay-{{ forloop.index }}">
          <p class="testimonial__quote">{{ block.settings.quote }}</p>
          <footer class="testimonial__author">
            <div class="testimonial__avatar" aria-hidden="true">{{ block.settings.initials }}</div>
            <div>
              <cite class="testimonial__name">{{ block.settings.name }}</cite>
              <p class="testimonial__role">{{ block.settings.role }}</p>
            </div>
          </footer>
        </blockquote>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "class": "testimonials-section",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Section tag",
      "default": "Stories of Impact"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What People Are Saying"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Lives transformed through deeper prayer"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "These cards have completely changed how I approach prayer."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Sarah M."
        },
        {
          "type": "text",
          "id": "initials",
          "label": "Initials",
          "default": "SM"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role / Location",
          "default": "Youth Leader"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "The Prayer Prompts were incredibly helpful. Our youth group now has a tangible way to engage with prayer that doesn't feel forced or awkward. The cards open up real conversations with God.",
            "name": "Youth Leader",
            "initials": "YL",
            "role": "North Island, NZ"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "I've always struggled to know what to pray. These cards meet me exactly where I am emotionally and help me find words when I have none. They've completely changed my quiet times.",
            "name": "Sarah M.",
            "initials": "SM",
            "role": "Christchurch, NZ"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "We use these in our small group and they've helped people who've never prayed out loud feel comfortable sharing. The Scripture connections are beautiful and relevant.",
            "name": "David K.",
            "initials": "DK",
            "role": "Small Group Leader"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Leaders could immediately see how these cards open up prayer in a way that's simple, real, and accessible for young people. Instant hit at our youth leaders conference.",
            "name": "Baptist Youth",
            "initials": "BYM",
            "role": "Rotorua, NZ"
          }
        }
      ]
    }
  ]
}
{% endschema %}
