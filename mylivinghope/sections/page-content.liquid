{% comment %}
  Flexible Page Content Section
  Allows adding various content blocks: text, images, image+text, quotes, etc.
{% endcomment %}

<style>
.page-content {
  padding: 3rem 0;
}

@media (min-width: 768px) {
  .page-content {
    padding: 4rem 0;
  }
}

.page-content--blush {
  background: #F5D7CF;
}

.page-content--cream {
  background: #FDF8F5;
}

.page-content--white {
  background: #fff;
}

.page-content__container {
  max-width: 900px;
  margin: 0 auto;
  padding: 0 5%;
}

.page-content__container--wide {
  max-width: 1200px;
}

/* Text Block */
.content-text {
  margin-bottom: 2rem;
}

.content-text:last-child {
  margin-bottom: 0;
}

.content-text h2 {
  font-family: var(--font-heading, 'Libre Baskerville', serif);
  font-size: clamp(1.5rem, 3vw, 2rem);
  color: #212021;
  margin-bottom: 1rem;
  line-height: 1.3;
}

.content-text h3 {
  font-family: var(--font-heading, 'Libre Baskerville', serif);
  font-size: clamp(1.25rem, 2.5vw, 1.5rem);
  color: #212021;
  margin-bottom: 0.75rem;
  line-height: 1.3;
}

.content-text p {
  font-size: 1.0625rem;
  line-height: 1.9;
  color: #5a5758;
  margin-bottom: 1rem;
}

.content-text p:last-child {
  margin-bottom: 0;
}

/* Image Block */
.content-image {
  margin-bottom: 2rem;
}

.content-image:last-child {
  margin-bottom: 0;
}

.content-image img {
  width: 100%;
  border-radius: 16px;
  box-shadow: 0 10px 25px rgba(33, 32, 33, 0.1);
}

.content-image figcaption {
  text-align: center;
  font-size: 0.875rem;
  color: #8a8788;
  margin-top: 0.75rem;
  font-style: italic;
}

/* Image + Text Block */
.content-image-text {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2rem;
  align-items: center;
  margin-bottom: 3rem;
}

@media (min-width: 768px) {
  .content-image-text {
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }
}

.content-image-text:last-child {
  margin-bottom: 0;
}

.content-image-text--reverse .content-image-text__image {
  order: 1;
}

@media (min-width: 768px) {
  .content-image-text--reverse .content-image-text__image {
    order: 2;
  }

  .content-image-text--reverse .content-image-text__content {
    order: 1;
  }
}

.content-image-text__image img {
  width: 100%;
  border-radius: 16px;
  box-shadow: 0 10px 25px rgba(33, 32, 33, 0.1);
}

.content-image-text__content h2 {
  font-family: var(--font-heading, 'Libre Baskerville', serif);
  font-size: clamp(1.5rem, 3vw, 2rem);
  color: #212021;
  margin-bottom: 1rem;
  line-height: 1.3;
}

.content-image-text__content h2 span {
  color: #336F49;
}

.content-image-text__content p {
  font-size: 1.0625rem;
  line-height: 1.9;
  color: #5a5758;
  margin-bottom: 1rem;
}

.content-image-text__content p:last-child {
  margin-bottom: 0;
}

/* Quote/Scripture Block */
.content-quote {
  background: linear-gradient(135deg, #FBE9E4 0%, #F5D7CF 100%);
  padding: 2rem;
  border-radius: 16px;
  border-left: 4px solid #336F49;
  margin-bottom: 2rem;
}

@media (min-width: 768px) {
  .content-quote {
    padding: 2.5rem;
  }
}

.content-quote:last-child {
  margin-bottom: 0;
}

.content-quote__text {
  font-family: var(--font-heading, 'Libre Baskerville', serif);
  font-size: clamp(1.125rem, 2.5vw, 1.5rem);
  font-style: italic;
  color: #212021;
  line-height: 1.6;
  margin-bottom: 0.75rem;
}

.content-quote__cite {
  font-family: var(--font-body, 'Montserrat', sans-serif);
  font-size: 0.9rem;
  font-weight: 600;
  color: #336F49;
  font-style: normal;
}

/* Heading Block */
.content-heading {
  text-align: center;
  margin-bottom: 2rem;
}

.content-heading:last-child {
  margin-bottom: 0;
}

.content-heading__tag {
  display: inline-block;
  font-family: var(--font-body, 'Montserrat', sans-serif);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #336F49;
  margin-bottom: 1rem;
  padding: 0.25rem 1rem;
  background: rgba(51, 111, 73, 0.1);
  border-radius: 50px;
}

.content-heading h2 {
  font-family: var(--font-heading, 'Libre Baskerville', serif);
  font-size: clamp(1.75rem, 4vw, 2.5rem);
  color: #212021;
  margin-bottom: 0.75rem;
  line-height: 1.2;
}

.content-heading p {
  font-size: 1.125rem;
  color: #8a8788;
  max-width: 600px;
  margin: 0 auto;
}

/* Button Block */
.content-button {
  text-align: center;
  margin: 2rem 0;
}

.content-button:last-child {
  margin-bottom: 0;
}

.content-button a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 1rem 2rem;
  background: #336F49;
  color: #fff;
  font-family: var(--font-body, 'Montserrat', sans-serif);
  font-size: 0.9375rem;
  font-weight: 600;
  text-decoration: none;
  border-radius: 50px;
  transition: all 0.25s ease;
}

.content-button a:hover {
  background: #265438;
  transform: translateY(-2px);
}

.content-button--secondary a {
  background: transparent;
  color: #212021;
  border: 2px solid #212021;
}

.content-button--secondary a:hover {
  background: #212021;
  color: #fff;
}

/* Divider */
.content-divider {
  height: 1px;
  background: #E8C4BA;
  margin: 2rem 0;
}

.content-divider--spacer {
  background: transparent;
  height: 2rem;
}

@media (min-width: 768px) {
  .content-divider--spacer {
    height: 3rem;
  }
}
</style>

<section class="page-content page-content--{{ section.settings.background }}">
  <div class="page-content__container{% if section.settings.wide_layout %} page-content__container--wide{% endif %}">
    {% for block in section.blocks %}
      {% case block.type %}

        {% when 'heading' %}
          <div class="content-heading" {{ block.shopify_attributes }}>
            {% if block.settings.tag != blank %}
              <span class="content-heading__tag">{{ block.settings.tag }}</span>
            {% endif %}
            {% if block.settings.title != blank %}
              <h2>{{ block.settings.title }}</h2>
            {% endif %}
            {% if block.settings.subtitle != blank %}
              <p>{{ block.settings.subtitle }}</p>
            {% endif %}
          </div>

        {% when 'text' %}
          <div class="content-text" {{ block.shopify_attributes }}>
            {% if block.settings.heading != blank %}
              <h2>{{ block.settings.heading }}</h2>
            {% endif %}
            {% if block.settings.subheading != blank %}
              <h3>{{ block.settings.subheading }}</h3>
            {% endif %}
            {{ block.settings.text }}
          </div>

        {% when 'image' %}
          <figure class="content-image" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <img
                src="{{ block.settings.image | image_url: width: 1200 }}"
                alt="{{ block.settings.image.alt | default: 'Image' }}"
                width="1200"
                height="auto"
                loading="lazy"
              >
            {% endif %}
            {% if block.settings.caption != blank %}
              <figcaption>{{ block.settings.caption }}</figcaption>
            {% endif %}
          </figure>

        {% when 'image_text' %}
          <div class="content-image-text{% if block.settings.reverse %} content-image-text--reverse{% endif %}" {{ block.shopify_attributes }}>
            <div class="content-image-text__image">
              {% if block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  alt="{{ block.settings.image.alt | default: 'Image' }}"
                  width="800"
                  height="auto"
                  loading="lazy"
                >
              {% endif %}
            </div>
            <div class="content-image-text__content">
              {% if block.settings.heading != blank %}
                <h2>{{ block.settings.heading }}</h2>
              {% endif %}
              {{ block.settings.text }}
            </div>
          </div>

        {% when 'quote' %}
          <blockquote class="content-quote" {{ block.shopify_attributes }}>
            <p class="content-quote__text">{{ block.settings.quote }}</p>
            {% if block.settings.citation != blank %}
              <cite class="content-quote__cite">— {{ block.settings.citation }}</cite>
            {% endif %}
          </blockquote>

        {% when 'button' %}
          <div class="content-button{% if block.settings.style == 'secondary' %} content-button--secondary{% endif %}" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link }}">
              {{ block.settings.label }}
            </a>
          </div>

        {% when 'divider' %}
          <div class="content-divider{% if block.settings.type == 'spacer' %} content-divider--spacer{% endif %}" {{ block.shopify_attributes }}></div>

      {% endcase %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Page Content",
  "class": "page-content-section",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Background color",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" },
        { "value": "blush", "label": "Blush" }
      ],
      "default": "cream"
    },
    {
      "type": "checkbox",
      "id": "wide_layout",
      "label": "Wide layout",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Section Heading",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Tag text (optional)",
          "placeholder": "Our Story"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "About Us"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle (optional)"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text Paragraph",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading (optional)"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading (optional)"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text content",
          "default": "<p>Add your paragraph text here. You can use formatting like <strong>bold</strong> and <em>italic</em>.</p>"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption (optional)"
        }
      ]
    },
    {
      "type": "image_text",
      "name": "Image + Text",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "html",
          "id": "heading",
          "label": "Heading (HTML allowed for emphasis)",
          "default": "Our <span>Story</span>"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text content",
          "default": "<p>Share your story here with an accompanying image.</p>"
        },
        {
          "type": "checkbox",
          "id": "reverse",
          "label": "Image on right (desktop)",
          "default": false
        }
      ]
    },
    {
      "type": "quote",
      "name": "Quote / Scripture",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote text",
          "default": "\"Your word is a lamp for my feet, a light on my path.\""
        },
        {
          "type": "text",
          "id": "citation",
          "label": "Citation / Reference",
          "default": "Psalm 119:105"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button text",
          "default": "Learn More"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Button style",
          "options": [
            { "value": "primary", "label": "Primary (green)" },
            { "value": "secondary", "label": "Secondary (outline)" }
          ],
          "default": "primary"
        }
      ]
    },
    {
      "type": "divider",
      "name": "Divider / Spacer",
      "settings": [
        {
          "type": "select",
          "id": "type",
          "label": "Type",
          "options": [
            { "value": "line", "label": "Line" },
            { "value": "spacer", "label": "Spacer (invisible)" }
          ],
          "default": "line"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Page Content",
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "tag": "Our Story",
            "title": "About My Living Hope",
            "subtitle": "Prayer cards born from a heart for connection"
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "<p>Prayer Portals were born from a simple observation: many of us want to connect with God but struggle to find the words. Whether you're feeling overwhelmed, grateful, confused, or hopeful—these cards meet you where you are.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
