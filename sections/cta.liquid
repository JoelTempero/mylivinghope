{% comment %}
  Call to Action Section
{% endcomment %}

<section class="section cta">
  <div class="cta__glow" aria-hidden="true"></div>
  <div class="container">
    <div class="cta__content reveal">
      <h2>{{ section.settings.heading | default: "Ready to Transform Your Prayer Life?" }}</h2>
      <p>{{ section.settings.description | default: "Join thousands who have discovered a new way to connect with God through Prayer Portals. Perfect for personal devotion, youth groups, small groups, and ministry." }}</p>
      {% if section.settings.button_link != blank %}
        <a href="{{ section.settings.button_link }}" class="btn btn--primary btn--large">
          {{ section.settings.button_text | default: "Get Your Cards Today" }}
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Call to Action",
  "class": "cta-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to Transform Your Prayer Life?"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Join thousands who have discovered a new way to connect with God through Prayer Portals. Perfect for personal devotion, youth groups, small groups, and ministry."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Get Your Cards Today"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Call to Action"
    }
  ]
}
{% endschema %}
