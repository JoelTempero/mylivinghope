{% comment %}
  Page Header Section
  Displays the page title with optional subtitle
{% endcomment %}

<style>
.page-header-section {
  background: linear-gradient(135deg, var(--forest-green, #336F49) 0%, var(--green-dark, #265438) 100%);
  padding: 3rem 0;
  text-align: center;
}

@media (min-width: 768px) {
  .page-header-section {
    padding: 4rem 0;
  }
}

.page-header-section__container {
  max-width: 800px;
  margin: 0 auto;
  padding: 0 5%;
}

.page-header-section h1 {
  font-family: var(--font-heading, 'Libre Baskerville', serif);
  font-size: clamp(2rem, 5vw, 3rem);
  color: #fff;
  margin: 0 0 0.5rem 0;
  line-height: 1.2;
}

.page-header-section p {
  font-size: 1.125rem;
  color: rgba(255, 255, 255, 0.85);
  margin: 0;
  line-height: 1.6;
}
</style>

<div class="page-header-section">
  <div class="page-header-section__container">
    <h1>{{ page.title }}</h1>
    {% if section.settings.subtitle != blank %}
      <p>{{ section.settings.subtitle }}</p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Page Header",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle (optional)",
      "placeholder": "A brief description of this page"
    }
  ],
  "presets": [
    {
      "name": "Page Header"
    }
  ]
}
{% endschema %}
