{% comment %}
  Footer Section with Newsletter Signup
{% endcomment %}

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <h3>{{ section.settings.heading | default: shop.name }}</h3>
        <p>{{ section.settings.description | default: "Prayer Portals — helping you go deeper with Jesus through prayer. Connect your emotions with Scripture and discover new ways to commune with God." }}</p>
        
        <!-- Newsletter Signup -->
        <div class="footer__newsletter">
          <h4>{{ section.settings.newsletter_heading | default: "Join Our Email List" }}</h4>
          <p>{{ section.settings.newsletter_text | default: "Get updates, encouragement, and early access to new products." }}</p>
          
          {% form 'customer', class: 'newsletter-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <input 
              type="email" 
              name="contact[email]" 
              class="newsletter-form__input" 
              placeholder="{{ section.settings.newsletter_placeholder | default: 'Enter your email' }}"
              aria-label="Email address"
              required
            >
            <button type="submit" class="newsletter-form__btn">
              {{ section.settings.newsletter_button | default: 'Subscribe' }}
            </button>
          {% endform %}
        </div>
      </div>

      <nav class="footer__column" aria-label="Quick links">
        <h4>{{ section.settings.menu_1_title | default: "Quick Links" }}</h4>
        <ul>
          {% for link in section.settings.menu_1.links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </nav>

      <nav class="footer__column" aria-label="Shop">
        <h4>{{ section.settings.menu_2_title | default: "Shop" }}</h4>
        <ul>
          {% for link in section.settings.menu_2.links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </nav>

      <nav class="footer__column" aria-label="Support">
        <h4>{{ section.settings.menu_3_title | default: "Support" }}</h4>
        <ul>
          {% for link in section.settings.menu_3.links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </nav>
    </div>

    <div class="footer__bottom">
      <p class="footer__copyright">
        © {{ 'now' | date: '%Y' }} {{ shop.name }}. Made with ♥ in Christchurch, New Zealand.
      </p>

      <div class="footer__social">
        {% if section.settings.social_facebook != blank %}
          <a href="{{ section.settings.social_facebook }}" target="_blank" rel="noopener noreferrer" aria-label="Follow us on Facebook">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
        {% endif %}

        {% if section.settings.social_instagram != blank %}
          <a href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener noreferrer" aria-label="Follow us on Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
        {% endif %}

        {% if section.settings.social_youtube != blank %}
          <a href="{{ section.settings.social_youtube }}" target="_blank" rel="noopener noreferrer" aria-label="Subscribe on YouTube">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/></svg>
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "footer-section",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "My Living Hope"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Prayer Portals — helping you go deeper with Jesus through prayer. Connect your emotions with Scripture and discover new ways to commune with God."
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Join Our Email List"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Newsletter text",
      "default": "Get updates, encouragement, and early access to new products."
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "Button text",
      "default": "Subscribe"
    },
    {
      "type": "header",
      "content": "Menu 1"
    },
    {
      "type": "text",
      "id": "menu_1_title",
      "label": "Title",
      "default": "Quick Links"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Menu",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "Menu 2"
    },
    {
      "type": "text",
      "id": "menu_2_title",
      "label": "Title",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Menu"
    },
    {
      "type": "header",
      "content": "Menu 3"
    },
    {
      "type": "text",
      "id": "menu_3_title",
      "label": "Title",
      "default": "Support"
    },
    {
      "type": "link_list",
      "id": "menu_3",
      "label": "Menu"
    },
    {
      "type": "header",
      "content": "Social Media"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "YouTube URL"
    }
  ]
}
{% endschema %}
