{% comment %}
  Contact Section with success/failure messages
{% endcomment %}

<style>
.contact-form__message {
  padding: 1rem 1.5rem;
  border-radius: 8px;
  margin-bottom: 1.5rem;
  font-weight: 500;
}

.contact-form__message--success {
  background: rgba(51, 111, 73, 0.1);
  color: var(--forest-green, #336F49);
  border: 1px solid var(--forest-green, #336F49);
}

.contact-form__message--error {
  background: rgba(220, 53, 69, 0.1);
  color: #dc3545;
  border: 1px solid #dc3545;
}

.contact-form__message--success::before {
  content: "✓ ";
}

.contact-form__message--error::before {
  content: "✗ ";
}
</style>

<section class="section section--blush" id="contact">
  <div class="container">
    <div class="contact__grid">
      <div class="contact__info reveal">
        <h2>{{ section.settings.heading | default: "Get in Touch" }}</h2>
        <p>{{ section.settings.description | default: "Have questions about Prayer Portals or want to order in bulk for your ministry? We'd love to hear from you." }}</p>

        <address class="contact__details">
          {% if section.settings.location != blank %}
            <div class="contact__item">
              <div class="contact__icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
              </div>
              <div>
                <p class="contact__label">Location</p>
                <p class="contact__value">{{ section.settings.location }}</p>
              </div>
            </div>
          {% endif %}

          {% if section.settings.phone != blank %}
            <div class="contact__item">
              <div class="contact__icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
              </div>
              <div>
                <p class="contact__label">Phone</p>
                <p class="contact__value"><a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a></p>
              </div>
            </div>
          {% endif %}

          {% if section.settings.email != blank %}
            <div class="contact__item">
              <div class="contact__icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
              </div>
              <div>
                <p class="contact__label">Email</p>
                <p class="contact__value"><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></p>
              </div>
            </div>
          {% endif %}
        </address>
      </div>

      <div class="contact__form reveal">
        {% form 'contact', id: 'contact-form' %}
          {% if form.posted_successfully? %}
            <div class="contact-form__message contact-form__message--success">
              Thank you for your message! We'll get back to you soon.
            </div>
          {% endif %}

          {% if form.errors %}
            <div class="contact-form__message contact-form__message--error">
              Sorry, there was an error submitting your message. Please try again.
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="form__group">
            <label for="contact-name" class="form__label">Name *</label>
            <input 
              type="text" 
              id="contact-name" 
              name="contact[name]" 
              class="form__input" 
              required 
              placeholder="Your name" 
              autocomplete="name"
              value="{{ form.name }}"
            >
          </div>

          <div class="form__group">
            <label for="contact-email" class="form__label">Email *</label>
            <input 
              type="email" 
              id="contact-email" 
              name="contact[email]" 
              class="form__input" 
              required 
              placeholder="your@email.com" 
              autocomplete="email"
              value="{{ form.email }}"
            >
          </div>

          <div class="form__group">
            <label for="contact-phone" class="form__label">Phone (optional)</label>
            <input 
              type="tel" 
              id="contact-phone" 
              name="contact[phone]" 
              class="form__input" 
              placeholder="Your phone number"
              autocomplete="tel"
            >
          </div>

          <div class="form__group">
            <label for="contact-message" class="form__label">Message *</label>
            <textarea 
              id="contact-message" 
              name="contact[body]" 
              class="form__textarea" 
              required 
              placeholder="Tell us how we can help..."
            >{{ form.body }}</textarea>
          </div>

          <button type="submit" class="btn btn--primary form__submit">
            Send Message
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
          </button>
        {% endform %}
      </div>
    </div>
  </div>
</section>

<script>
// Scroll to form if there's a success or error message
document.addEventListener('DOMContentLoaded', function() {
  var message = document.querySelector('.contact-form__message');
  if (message) {
    message.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
});
</script>

{% schema %}
{
  "name": "Contact",
  "class": "contact-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in Touch"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Have questions about Prayer Portals or want to order in bulk for your ministry? We'd love to hear from you."
    },
    {
      "type": "text",
      "id": "location",
      "label": "Location",
      "default": "Christchurch, New Zealand"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "027 569 0061"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email"
    }
  ],
  "presets": [
    {
      "name": "Contact"
    }
  ]
}
{% endschema %}
