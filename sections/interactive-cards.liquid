{% comment %}
  Interactive Prayer Cards Section
  Cards start centered, can be dragged, proper cursor offset tracking
{% endcomment %}

<style>
.interactive-cards-section {
  padding: 6rem 0;
  overflow: visible;
}

.interactive-cards__wrapper {
  position: relative;
  min-height: 450px;
  max-width: 1400px;
  margin: 0 auto;
  padding: 2rem;
}

.interactive-cards__container {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  gap: 2rem;
  min-height: 350px;
}

.interactive-cards__empty {
  text-align: center;
  color: var(--text-muted, #8a8788);
  font-style: italic;
  padding: 4rem 2rem;
}

.prayer-card {
  position: relative;
  width: {{ section.settings.card_width }}px;
  height: {{ section.settings.card_height }}px;
  cursor: grab;
  perspective: 1000px;
  user-select: none;
  flex-shrink: 0;
  touch-action: none;
}

.prayer-card:active {
  cursor: grabbing;
}

.prayer-card--dragging {
  z-index: 100 !important;
}

.prayer-card__inner {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transition: transform 0.6s ease;
  border-radius: {{ section.settings.card_radius }}px;
  box-shadow: 0 10px 30px rgba(33, 32, 33, 0.2);
}

.prayer-card--flipped .prayer-card__inner {
  transform: rotateY(180deg) rotate(-90deg);
}

.prayer-card__front,
.prayer-card__back {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  border-radius: {{ section.settings.card_radius }}px;
  overflow: hidden;
  background: var(--soft-blush, #F5D7CF);
}

.prayer-card__front img,
.prayer-card__back img {
  width: 100%;
  height: 100%;
  object-fit: {{ section.settings.image_fit }};
  object-position: {{ section.settings.image_position }};
  pointer-events: none;
}

.prayer-card__back {
  transform: rotateY(180deg);
  background: var(--forest-green, #336F49);
}

.prayer-card__placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-body, 'Montserrat', sans-serif);
  font-size: 0.875rem;
  color: var(--text-muted, #8a8788);
  background: linear-gradient(135deg, #f0f0f0 0%, #e0e0e0 100%);
}

.interactive-cards__hint {
  text-align: center;
  margin-top: 2rem;
  color: var(--text-muted, #8a8788);
  font-size: 0.9375rem;
}

/* Responsive scaling */
@media (max-width: 1200px) {
  .prayer-card {
    width: calc({{ section.settings.card_width }}px * 0.8);
    height: calc({{ section.settings.card_height }}px * 0.8);
  }
}

@media (max-width: 768px) {
  .interactive-cards__wrapper {
    padding: 1rem;
    min-height: 400px;
  }
  
  .interactive-cards__container {
    gap: 1rem;
  }
  
  .prayer-card {
    width: calc({{ section.settings.card_width }}px * 0.65);
    height: calc({{ section.settings.card_height }}px * 0.65);
  }
}

@media (max-width: 480px) {
  .prayer-card {
    width: calc({{ section.settings.card_width }}px * 0.5);
    height: calc({{ section.settings.card_height }}px * 0.5);
  }
}
</style>

<section class="section interactive-cards-section" id="try-cards">
  <div class="container">
    <header class="section-header">
      <span class="section-tag">{{ section.settings.tag }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p style="color: var(--text-muted);">{{ section.settings.description }}</p>
    </header>

    <div class="interactive-cards__wrapper">
      <div class="interactive-cards__container" id="cardsContainer">
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            <div class="prayer-card" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <div class="prayer-card__inner">
                <div class="prayer-card__front">
                  {% if block.settings.front_image %}
                    <img 
                      src="{{ block.settings.front_image | image_url: width: 900 }}" 
                      alt="Prayer card front" 
                      draggable="false"
                      loading="lazy"
                    >
                  {% else %}
                    <div class="prayer-card__placeholder">
                      Add front image
                    </div>
                  {% endif %}
                </div>
                <div class="prayer-card__back">
                  {% if block.settings.back_image %}
                    <img 
                      src="{{ block.settings.back_image | image_url: width: 900 }}" 
                      alt="Prayer card back" 
                      draggable="false"
                      loading="lazy"
                    >
                  {% else %}
                    <div class="prayer-card__placeholder">
                      Add back image
                    </div>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        {% else %}
          <div class="interactive-cards__empty">
            <p>Add cards using the "Add Card" button in the sidebar</p>
          </div>
        {% endif %}
      </div>
    </div>

    {% if section.blocks.size > 0 %}
      <p class="interactive-cards__hint">
        {{ section.settings.hint_text }}
      </p>
    {% endif %}
  </div>
</section>

<script>
(function() {
  var cards = document.querySelectorAll('.prayer-card');
  if (!cards.length) return;

  var isDragging = false;
  var currentCard = null;
  var currentIndex = -1;
  var offsetX = 0;
  var offsetY = 0;
  var hasMoved = false;
  var highestZ = 10;
  
  // Store each card's position
  var positions = [];
  for (var i = 0; i < cards.length; i++) {
    positions[i] = { x: 0, y: 0 };
    cards[i].style.zIndex = i + 1;
  }

  // Add event listeners
  for (var i = 0; i < cards.length; i++) {
    addDragListeners(cards[i], i);
  }

  function addDragListeners(card, index) {
    card.addEventListener('mousedown', function(e) {
      startDrag(e, index);
    });
    card.addEventListener('touchstart', function(e) {
      startDrag(e, index);
    }, { passive: false });
  }

  function startDrag(e, index) {
    e.preventDefault();
    
    currentCard = cards[index];
    currentIndex = index;
    isDragging = true;
    hasMoved = false;

    // Bring to front
    highestZ++;
    currentCard.style.zIndex = highestZ;
    currentCard.classList.add('prayer-card--dragging');

    // Get cursor/touch position
    var clientX, clientY;
    if (e.type === 'touchstart') {
      clientX = e.touches[0].clientX;
      clientY = e.touches[0].clientY;
    } else {
      clientX = e.clientX;
      clientY = e.clientY;
    }

    // Get card's current position on screen
    var rect = currentCard.getBoundingClientRect();
    
    // Calculate offset from cursor to card's top-left corner
    // This keeps the card anchored to where user clicked
    offsetX = clientX - rect.left + positions[index].x;
    offsetY = clientY - rect.top + positions[index].y;

    // Add move/end listeners to document
    document.addEventListener('mousemove', onDrag);
    document.addEventListener('mouseup', endDrag);
    document.addEventListener('touchmove', onDrag, { passive: false });
    document.addEventListener('touchend', endDrag);
  }

  function onDrag(e) {
    if (!isDragging || !currentCard) return;
    e.preventDefault();

    var clientX, clientY;
    if (e.type === 'touchmove') {
      clientX = e.touches[0].clientX;
      clientY = e.touches[0].clientY;
    } else {
      clientX = e.clientX;
      clientY = e.clientY;
    }

    // Calculate new position maintaining the grab offset
    var rect = currentCard.getBoundingClientRect();
    var newX = clientX - (rect.left - positions[currentIndex].x) - (offsetX - positions[currentIndex].x);
    var newY = clientY - (rect.top - positions[currentIndex].y) - (offsetY - positions[currentIndex].y);

    // Check if moved enough to count as drag
    if (Math.abs(newX - positions[currentIndex].x) > 3 || Math.abs(newY - positions[currentIndex].y) > 3) {
      hasMoved = true;
    }

    // Apply transform
    currentCard.style.transform = 'translate(' + newX + 'px, ' + newY + 'px)';
    positions[currentIndex].x = newX;
    positions[currentIndex].y = newY;
  }

  function endDrag(e) {
    if (!currentCard) return;

    // Remove listeners
    document.removeEventListener('mousemove', onDrag);
    document.removeEventListener('mouseup', endDrag);
    document.removeEventListener('touchmove', onDrag);
    document.removeEventListener('touchend', endDrag);

    currentCard.classList.remove('prayer-card--dragging');

    // If didn't move, toggle flip
    if (!hasMoved) {
      currentCard.classList.toggle('prayer-card--flipped');
    }

    isDragging = false;
    currentCard = null;
    currentIndex = -1;
  }
})();
</script>

{% schema %}
{
  "name": "Interactive Cards",
  "settings": [
    {
      "type": "header",
      "content": "Section Text"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Tag",
      "default": "Try It Out"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Experience Prayer Portals"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Drag the cards around. Click one to flip it over and see how it works."
    },
    {
      "type": "text",
      "id": "hint_text",
      "label": "Hint text",
      "default": "Drag cards to move them • Click to flip and reveal Scripture"
    },
    {
      "type": "header",
      "content": "Card Dimensions"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card width (px)",
      "min": 200,
      "max": 600,
      "step": 10,
      "default": 420,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Card height (px)",
      "min": 150,
      "max": 500,
      "step": 10,
      "default": 300,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        { "value": "cover", "label": "Cover (crop to fill)" },
        { "value": "contain", "label": "Contain (show full image)" },
        { "value": "fill", "label": "Stretch to fill" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (when cropped)",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" },
        { "value": "top left", "label": "Top Left" },
        { "value": "top right", "label": "Top Right" },
        { "value": "bottom left", "label": "Bottom Left" },
        { "value": "bottom right", "label": "Bottom Right" }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "front_image",
          "label": "Front image"
        },
        {
          "type": "image_picker",
          "id": "back_image",
          "label": "Back image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Interactive Cards",
      "blocks": []
    }
  ]
}
{% endschema %}
