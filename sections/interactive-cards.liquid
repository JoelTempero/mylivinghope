{% comment %}
  Interactive Prayer Cards Section
  Cards start centered and spread evenly - always visible
{% endcomment %}

<style>
.interactive-cards-section {
  padding: 6rem 0;
  overflow: visible;
}

.interactive-cards__container {
  position: relative;
  min-height: 400px;
  max-width: 1400px;
  margin: 0 auto;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  gap: 2rem;
  padding: 2rem;
}

.interactive-cards__empty {
  text-align: center;
  color: var(--text-muted, #8a8788);
  font-style: italic;
  padding: 4rem 2rem;
}

.prayer-card {
  position: relative;
  width: {{ section.settings.card_width }}px;
  height: {{ section.settings.card_height }}px;
  cursor: grab;
  perspective: 1000px;
  user-select: none;
  flex-shrink: 0;
}

.prayer-card:active {
  cursor: grabbing;
}

.prayer-card__inner {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transition: transform 0.6s ease;
  border-radius: {{ section.settings.card_radius }}px;
  box-shadow: 0 10px 30px rgba(33, 32, 33, 0.2);
}

.prayer-card--flipped .prayer-card__inner {
  transform: rotateY(180deg) rotate(-90deg);
}

.prayer-card__front,
.prayer-card__back {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: {{ section.settings.card_radius }}px;
  overflow: hidden;
  background: var(--soft-blush, #F5D7CF);
}

.prayer-card__front img,
.prayer-card__back img {
  width: 100%;
  height: 100%;
  object-fit: {{ section.settings.image_fit }};
  object-position: {{ section.settings.image_position }};
}

.prayer-card__back {
  transform: rotateY(180deg);
  background: var(--forest-green, #336F49);
}

.prayer-card__placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-body, 'Montserrat', sans-serif);
  font-size: 0.875rem;
  color: var(--text-muted, #8a8788);
  background: linear-gradient(135deg, #f0f0f0 0%, #e0e0e0 100%);
}

.interactive-cards__hint {
  text-align: center;
  margin-top: 2rem;
  color: var(--text-muted, #8a8788);
  font-size: 0.9375rem;
}

/* Responsive scaling */
@media (max-width: 1200px) {
  .prayer-card {
    width: calc({{ section.settings.card_width }}px * 0.85);
    height: calc({{ section.settings.card_height }}px * 0.85);
  }
}

@media (max-width: 768px) {
  .prayer-card {
    width: calc({{ section.settings.card_width }}px * 0.7);
    height: calc({{ section.settings.card_height }}px * 0.7);
  }
  
  .interactive-cards__container {
    gap: 1.5rem;
  }
}

@media (max-width: 480px) {
  .prayer-card {
    width: calc({{ section.settings.card_width }}px * 0.55);
    height: calc({{ section.settings.card_height }}px * 0.55);
  }
}
</style>

<section class="section interactive-cards-section" id="try-cards">
  <div class="container">
    <header class="section-header">
      <span class="section-tag">{{ section.settings.tag }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p style="color: var(--text-muted);">{{ section.settings.description }}</p>
    </header>

    <div class="interactive-cards__container" id="cardsContainer">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="prayer-card" data-index="{{ forloop.index }}" {{ block.shopify_attributes }}>
            <div class="prayer-card__inner">
              <div class="prayer-card__front">
                {% if block.settings.front_image %}
                  <img 
                    src="{{ block.settings.front_image | image_url: width: 900 }}" 
                    alt="Prayer card front" 
                    draggable="false"
                    loading="lazy"
                  >
                {% else %}
                  <div class="prayer-card__placeholder">
                    Add front image
                  </div>
                {% endif %}
              </div>
              <div class="prayer-card__back">
                {% if block.settings.back_image %}
                  <img 
                    src="{{ block.settings.back_image | image_url: width: 900 }}" 
                    alt="Prayer card back" 
                    draggable="false"
                    loading="lazy"
                  >
                {% else %}
                  <div class="prayer-card__placeholder">
                    Add back image
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <div class="interactive-cards__empty">
          <p>Add cards using the "Add Card" button in the sidebar</p>
        </div>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <p class="interactive-cards__hint">
        {{ section.settings.hint_text }}
      </p>
    {% endif %}
  </div>
</section>

<script>
(function() {
  var cards = document.querySelectorAll('.prayer-card');
  if (!cards.length) return;

  var isDragging = false;
  var currentCard = null;
  var startX = 0;
  var startY = 0;
  var currentX = 0;
  var currentY = 0;
  var hasMoved = false;
  var highestZ = 10;
  
  // Store each card's current transform
  var cardTransforms = [];

  for (var i = 0; i < cards.length; i++) {
    cards[i].style.zIndex = i + 1;
    cardTransforms[i] = { x: 0, y: 0 };
    
    (function(index) {
      cards[index].addEventListener('mousedown', function(e) { startDrag(e, index); });
      cards[index].addEventListener('touchstart', function(e) { startDrag(e, index); });
    })(i);
  }

  function startDrag(e, index) {
    currentCard = cards[index];
    isDragging = true;
    hasMoved = false;

    highestZ = highestZ + 1;
    currentCard.style.zIndex = highestZ;

    if (e.type === 'touchstart') {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
    } else {
      startX = e.clientX;
      startY = e.clientY;
    }

    currentX = cardTransforms[index].x;
    currentY = cardTransforms[index].y;

    currentCard.style.cursor = 'grabbing';

    document.addEventListener('mousemove', drag);
    document.addEventListener('mouseup', function(ev) { endDrag(ev, index); });
    document.addEventListener('touchmove', drag, { passive: false });
    document.addEventListener('touchend', function(ev) { endDrag(ev, index); });

    e.preventDefault();
  }

  function drag(e) {
    if (!isDragging || !currentCard) return;

    var clientX = 0;
    var clientY = 0;

    if (e.type === 'touchmove') {
      clientX = e.touches[0].clientX;
      clientY = e.touches[0].clientY;
      e.preventDefault();
    } else {
      clientX = e.clientX;
      clientY = e.clientY;
    }

    var deltaX = clientX - startX;
    var deltaY = clientY - startY;

    if (Math.abs(deltaX) > 5 || Math.abs(deltaY) > 5) {
      hasMoved = true;
    }

    var newX = currentX + deltaX;
    var newY = currentY + deltaY;

    currentCard.style.transform = 'translate(' + newX + 'px, ' + newY + 'px)';
  }

  function endDrag(e, index) {
    if (!currentCard) return;

    document.removeEventListener('mousemove', drag);
    document.removeEventListener('touchmove', drag);

    currentCard.style.cursor = 'grab';

    // Save current position
    var transform = currentCard.style.transform;
    var match = transform.match(/translate\(([^,]+)px,\s*([^)]+)px\)/);
    if (match) {
      cardTransforms[index].x = parseFloat(match[1]);
      cardTransforms[index].y = parseFloat(match[2]);
    }

    if (!hasMoved) {
      currentCard.classList.toggle('prayer-card--flipped');
    }

    isDragging = false;
    currentCard = null;
  }
})();
</script>

{% schema %}
{
  "name": "Interactive Cards",
  "settings": [
    {
      "type": "header",
      "content": "Section Text"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Tag",
      "default": "Try It Out"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Experience Prayer Portals"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Drag the cards around. Click one to flip it over and see how it works."
    },
    {
      "type": "text",
      "id": "hint_text",
      "label": "Hint text",
      "default": "Drag cards to move them • Click to flip and reveal Scripture"
    },
    {
      "type": "header",
      "content": "Card Dimensions"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card width (px)",
      "min": 200,
      "max": 600,
      "step": 10,
      "default": 420,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Card height (px)",
      "min": 150,
      "max": 500,
      "step": 10,
      "default": 300,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        { "value": "cover", "label": "Cover (crop to fill)" },
        { "value": "contain", "label": "Contain (show full image)" },
        { "value": "fill", "label": "Stretch to fill" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (when cropped)",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" },
        { "value": "top left", "label": "Top Left" },
        { "value": "top right", "label": "Top Right" },
        { "value": "bottom left", "label": "Bottom Left" },
        { "value": "bottom right", "label": "Bottom Right" }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "front_image",
          "label": "Front image"
        },
        {
          "type": "image_picker",
          "id": "back_image",
          "label": "Back image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Interactive Cards",
      "blocks": []
    }
  ]
}
{% endschema %}
