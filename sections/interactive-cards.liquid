{% comment %}
  Interactive Prayer Cards Section
  Drag cards around, click to flip in lightbox
{% endcomment %}

<section class="section interactive-cards" id="try-cards">
  <div class="container">
    <header class="section-header reveal">
      <span class="section-tag">{{ section.settings.tag | default: "Try It Out" }}</span>
      <h2>{{ section.settings.heading | default: "Experience Prayer Portals" }}</h2>
      <p>{{ section.settings.description | default: "Drag the cards around. Click one to flip it over and see how it works." }}</p>
    </header>

    <div class="interactive-cards__container" id="cardsContainer">
      {% for block in section.blocks %}
        <div 
          class="prayer-card" 
          data-card-id="{{ block.id }}"
          draggable="false"
          style="{% if block.settings.position_x %}left: {{ block.settings.position_x }}%;{% endif %}{% if block.settings.position_y %}top: {{ block.settings.position_y }}%;{% endif %}{% if block.settings.rotation %}transform: rotate({{ block.settings.rotation }}deg);{% endif %}"
        >
          <div class="prayer-card__inner">
            <div class="prayer-card__front">
              {% if block.settings.front_image %}
                <img 
                  src="{{ block.settings.front_image | image_url: width: 400 }}" 
                  alt="{{ block.settings.card_name | default: 'Prayer Card' }} - Front"
                  loading="lazy"
                  draggable="false"
                >
              {% else %}
                <img 
                  src="{{ 'card-' | append: forloop.index | append: '-front.jpg' | asset_url }}" 
                  alt="{{ block.settings.card_name | default: 'Prayer Card' }} - Front"
                  loading="lazy"
                  draggable="false"
                >
              {% endif %}
            </div>
            <div class="prayer-card__back">
              {% if block.settings.back_image %}
                <img 
                  src="{{ block.settings.back_image | image_url: width: 400 }}" 
                  alt="{{ block.settings.card_name | default: 'Prayer Card' }} - Back with Scripture"
                  loading="lazy"
                  draggable="false"
                >
              {% else %}
                <img 
                  src="{{ 'card-' | append: forloop.index | append: '-back.jpg' | asset_url }}" 
                  alt="{{ block.settings.card_name | default: 'Prayer Card' }} - Back with Scripture"
                  loading="lazy"
                  draggable="false"
                >
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <p class="interactive-cards__hint">
      <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 8h1a4 4 0 0 1 0 8h-1"/>
        <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/>
        <line x1="6" y1="1" x2="6" y2="4"/>
        <line x1="10" y1="1" x2="10" y2="4"/>
        <line x1="14" y1="1" x2="14" y2="4"/>
      </svg>
      {{ section.settings.hint_text | default: "Drag cards to move them • Click to flip and reveal Scripture" }}
    </p>
  </div>
</section>

<!-- Lightbox -->
<div class="card-lightbox" id="cardLightbox">
  <div class="prayer-card prayer-card--lightbox" id="lightboxCard">
    <div class="prayer-card__inner">
      <div class="prayer-card__front" id="lightboxFront"></div>
      <div class="prayer-card__back" id="lightboxBack"></div>
    </div>
  </div>
</div>

<script>
(function() {
  const container = document.getElementById('cardsContainer');
  const cards = document.querySelectorAll('.prayer-card:not(.prayer-card--lightbox)');
  const lightbox = document.getElementById('cardLightbox');
  const lightboxCard = document.getElementById('lightboxCard');
  const lightboxFront = document.getElementById('lightboxFront');
  const lightboxBack = document.getElementById('lightboxBack');

  let isDragging = false;
  let dragCard = null;
  let startX, startY, initialX, initialY;
  let hasMoved = false;
  let highestZ = 10;

  // Initialize card positions
  cards.forEach((card, index) => {
    card.style.zIndex = index + 1;
    
    // Drag start
    card.addEventListener('mousedown', startDrag);
    card.addEventListener('touchstart', startDrag, { passive: false });
  });

  function startDrag(e) {
    if (e.target.closest('.prayer-card--lightbox')) return;
    
    dragCard = e.currentTarget;
    isDragging = true;
    hasMoved = false;

    // Bring to front
    highestZ++;
    dragCard.style.zIndex = highestZ;

    const rect = dragCard.getBoundingClientRect();
    const containerRect = container.getBoundingClientRect();
    
    if (e.type === 'touchstart') {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
    } else {
      startX = e.clientX;
      startY = e.clientY;
    }

    initialX = rect.left - containerRect.left;
    initialY = rect.top - containerRect.top;

    dragCard.style.cursor = 'grabbing';
    dragCard.style.transition = 'none';

    // Clear percentage positioning, use pixels
    dragCard.style.left = initialX + 'px';
    dragCard.style.top = initialY + 'px';

    document.addEventListener('mousemove', drag);
    document.addEventListener('mouseup', endDrag);
    document.addEventListener('touchmove', drag, { passive: false });
    document.addEventListener('touchend', endDrag);

    e.preventDefault();
  }

  function drag(e) {
    if (!isDragging || !dragCard) return;

    let clientX, clientY;
    if (e.type === 'touchmove') {
      clientX = e.touches[0].clientX;
      clientY = e.touches[0].clientY;
      e.preventDefault();
    } else {
      clientX = e.clientX;
      clientY = e.clientY;
    }

    const deltaX = clientX - startX;
    const deltaY = clientY - startY;

    // Check if moved enough to count as a drag
    if (Math.abs(deltaX) > 5 || Math.abs(deltaY) > 5) {
      hasMoved = true;
    }

    const newX = initialX + deltaX;
    const newY = initialY + deltaY;

    // Keep within container bounds
    const containerRect = container.getBoundingClientRect();
    const cardRect = dragCard.getBoundingClientRect();
    
    const maxX = containerRect.width - cardRect.width;
    const maxY = containerRect.height - cardRect.height;

    dragCard.style.left = Math.max(0, Math.min(maxX, newX)) + 'px';
    dragCard.style.top = Math.max(0, Math.min(maxY, newY)) + 'px';
    
    // Remove rotation while dragging
    dragCard.style.transform = 'rotate(0deg)';
  }

  function endDrag(e) {
    if (!dragCard) return;

    document.removeEventListener('mousemove', drag);
    document.removeEventListener('mouseup', endDrag);
    document.removeEventListener('touchmove', drag);
    document.removeEventListener('touchend', endDrag);

    dragCard.style.cursor = 'grab';
    dragCard.style.transition = '';

    // If didn't move much, treat as click
    if (!hasMoved) {
      openLightbox(dragCard);
    }

    isDragging = false;
    dragCard = null;
  }

  function openLightbox(card) {
    const frontImg = card.querySelector('.prayer-card__front img');
    const backImg = card.querySelector('.prayer-card__back img');

    lightboxFront.innerHTML = `<img src="${frontImg.src}" alt="${frontImg.alt}" draggable="false">`;
    lightboxBack.innerHTML = `<img src="${backImg.src}" alt="${backImg.alt}" draggable="false">`;

    lightbox.classList.add('card-lightbox--active');
    lightboxCard.classList.remove('prayer-card--flipped');

    // Prevent body scroll
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lightbox.classList.remove('card-lightbox--active');
    lightboxCard.classList.remove('prayer-card--flipped');
    document.body.style.overflow = '';
  }

  // Click lightbox card to flip
  lightboxCard.addEventListener('click', function(e) {
    e.stopPropagation();
    this.classList.toggle('prayer-card--flipped');
  });

  // Click outside card to close
  lightbox.addEventListener('click', function(e) {
    if (e.target === lightbox) {
      closeLightbox();
    }
  });

  // ESC to close
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && lightbox.classList.contains('card-lightbox--active')) {
      closeLightbox();
    }
  });
})();
</script>

{% schema %}
{
  "name": "Interactive Cards",
  "class": "interactive-cards-section",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Section tag",
      "default": "Try It Out"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Experience Prayer Portals"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Drag the cards around. Click one to flip it over and see how it works."
    },
    {
      "type": "text",
      "id": "hint_text",
      "label": "Hint text",
      "default": "Drag cards to move them • Click to flip and reveal Scripture"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Prayer Card",
      "settings": [
        {
          "type": "text",
          "id": "card_name",
          "label": "Card name",
          "default": "Anxious"
        },
        {
          "type": "image_picker",
          "id": "front_image",
          "label": "Front image"
        },
        {
          "type": "image_picker",
          "id": "back_image",
          "label": "Back image"
        },
        {
          "type": "range",
          "id": "position_x",
          "label": "Horizontal position (%)",
          "min": 0,
          "max": 70,
          "step": 5,
          "default": 10
        },
        {
          "type": "range",
          "id": "position_y",
          "label": "Vertical position (%)",
          "min": 0,
          "max": 60,
          "step": 5,
          "default": 15
        },
        {
          "type": "range",
          "id": "rotation",
          "label": "Initial rotation (degrees)",
          "min": -15,
          "max": 15,
          "step": 1,
          "default": 0
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Interactive Cards",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "card_name": "Anxious",
            "position_x": 10,
            "position_y": 15,
            "rotation": -8
          }
        },
        {
          "type": "card",
          "settings": {
            "card_name": "Grateful",
            "position_x": 38,
            "position_y": 25,
            "rotation": 3
          }
        },
        {
          "type": "card",
          "settings": {
            "card_name": "Lonely",
            "position_x": 65,
            "position_y": 10,
            "rotation": -4
          }
        }
      ]
    }
  ]
}
{% endschema %}
