{% comment %}
  Interactive Prayer Cards Section
{% endcomment %}

<section class="section" id="try-cards" style="padding: 6rem 0;">
  <div class="container">
    <header class="section-header">
      <span class="section-tag">{{ section.settings.tag }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p style="color: var(--text-muted);">{{ section.settings.description }}</p>
    </header>

    <div id="cardsContainer" style="position: relative; height: 500px; max-width: 900px; margin: 0 auto;">
      {% for block in section.blocks %}
        <div 
          class="draggable-card" 
          data-index="{{ forloop.index }}"
          style="
            position: absolute;
            width: 200px;
            height: 280px;
            cursor: grab;
            z-index: {{ forloop.index }};
            left: {{ block.settings.position_x }}%;
            top: {{ block.settings.position_y }}%;
            transform: rotate({{ block.settings.rotation }}deg);
          "
        >
          <div class="card-inner" style="
            position: relative;
            width: 100%;
            height: 100%;
            transform-style: preserve-3d;
            transition: transform 0.6s ease;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(33,32,33,0.15);
          ">
            <div class="card-front" style="
              position: absolute;
              width: 100%;
              height: 100%;
              backface-visibility: hidden;
              border-radius: 16px;
              overflow: hidden;
            ">
              {% if block.settings.front_image %}
                <img src="{{ block.settings.front_image | image_url: width: 400 }}" alt="{{ block.settings.card_name }} - Front" style="width:100%;height:100%;object-fit:cover;" draggable="false">
              {% else %}
                <div style="width:100%;height:100%;background:var(--soft-blush);display:flex;align-items:center;justify-content:center;font-family:var(--font-heading);font-size:1.5rem;color:var(--charcoal);">{{ block.settings.card_name }}</div>
              {% endif %}
            </div>
            <div class="card-back" style="
              position: absolute;
              width: 100%;
              height: 100%;
              backface-visibility: hidden;
              border-radius: 16px;
              overflow: hidden;
              transform: rotateY(180deg);
            ">
              {% if block.settings.back_image %}
                <img src="{{ block.settings.back_image | image_url: width: 400 }}" alt="{{ block.settings.card_name }} - Back" style="width:100%;height:100%;object-fit:cover;" draggable="false">
              {% else %}
                <div style="width:100%;height:100%;background:var(--forest-green);display:flex;align-items:center;justify-content:center;font-family:var(--font-heading);font-size:1rem;color:white;padding:1rem;text-align:center;">Scripture and Prayer for {{ block.settings.card_name }}</div>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <p style="text-align:center;margin-top:2rem;color:var(--text-muted);font-size:0.9375rem;">
      Drag cards to move them - Click to flip and reveal Scripture
    </p>
  </div>
</section>

<div id="cardLightbox" style="
  position: fixed;
  inset: 0;
  background: rgba(33,32,33,0.85);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
  backdrop-filter: blur(5px);
">
  <div id="lightboxCardContainer" style="
    width: 280px;
    height: 400px;
    cursor: pointer;
    perspective: 1000px;
  ">
    <div id="lightboxCardInner" style="
      position: relative;
      width: 100%;
      height: 100%;
      transform-style: preserve-3d;
      transition: transform 0.6s ease;
      border-radius: 16px;
      box-shadow: 0 25px 50px rgba(0,0,0,0.3);
    ">
      <div id="lightboxFront" style="
        position: absolute;
        width: 100%;
        height: 100%;
        backface-visibility: hidden;
        border-radius: 16px;
        overflow: hidden;
        background: var(--soft-blush);
      "></div>
      <div id="lightboxBack" style="
        position: absolute;
        width: 100%;
        height: 100%;
        backface-visibility: hidden;
        border-radius: 16px;
        overflow: hidden;
        transform: rotateY(180deg);
        background: var(--forest-green);
      "></div>
    </div>
  </div>
</div>

<script>
(function() {
  var container = document.getElementById('cardsContainer');
  if (!container) return;
  
  var cards = document.querySelectorAll('.draggable-card');
  var lightbox = document.getElementById('cardLightbox');
  var lightboxInner = document.getElementById('lightboxCardInner');
  var lightboxFront = document.getElementById('lightboxFront');
  var lightboxBack = document.getElementById('lightboxBack');

  var isDragging = false;
  var currentCard = null;
  var startX = 0;
  var startY = 0;
  var initialX = 0;
  var initialY = 0;
  var hasMoved = false;
  var highestZ = 10;

  for (var i = 0; i < cards.length; i++) {
    cards[i].addEventListener('mousedown', startDrag);
    cards[i].addEventListener('touchstart', startDrag);
  }

  function startDrag(e) {
    currentCard = this;
    isDragging = true;
    hasMoved = false;

    highestZ = highestZ + 1;
    currentCard.style.zIndex = highestZ;

    var rect = currentCard.getBoundingClientRect();
    var containerRect = container.getBoundingClientRect();

    if (e.type === 'touchstart') {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
    } else {
      startX = e.clientX;
      startY = e.clientY;
    }

    initialX = rect.left - containerRect.left;
    initialY = rect.top - containerRect.top;

    currentCard.style.cursor = 'grabbing';
    currentCard.style.left = initialX + 'px';
    currentCard.style.top = initialY + 'px';
    currentCard.style.transform = 'rotate(0deg)';

    document.addEventListener('mousemove', drag);
    document.addEventListener('mouseup', endDrag);
    document.addEventListener('touchmove', drag);
    document.addEventListener('touchend', endDrag);

    e.preventDefault();
  }

  function drag(e) {
    if (!isDragging || !currentCard) return;

    var clientX = 0;
    var clientY = 0;
    
    if (e.type === 'touchmove') {
      clientX = e.touches[0].clientX;
      clientY = e.touches[0].clientY;
    } else {
      clientX = e.clientX;
      clientY = e.clientY;
    }

    var deltaX = clientX - startX;
    var deltaY = clientY - startY;

    if (Math.abs(deltaX) > 5 || Math.abs(deltaY) > 5) {
      hasMoved = true;
    }

    var newX = initialX + deltaX;
    var newY = initialY + deltaY;

    currentCard.style.left = newX + 'px';
    currentCard.style.top = newY + 'px';

    e.preventDefault();
  }

  function endDrag(e) {
    if (!currentCard) return;

    document.removeEventListener('mousemove', drag);
    document.removeEventListener('mouseup', endDrag);
    document.removeEventListener('touchmove', drag);
    document.removeEventListener('touchend', endDrag);

    currentCard.style.cursor = 'grab';

    if (!hasMoved) {
      openLightbox(currentCard);
    }

    isDragging = false;
    currentCard = null;
  }

  function openLightbox(card) {
    var front = card.querySelector('.card-front');
    var back = card.querySelector('.card-back');

    lightboxFront.innerHTML = front.innerHTML;
    lightboxBack.innerHTML = back.innerHTML;

    lightbox.style.opacity = '1';
    lightbox.style.visibility = 'visible';
    lightboxInner.style.transform = 'rotateY(0deg)';
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lightbox.style.opacity = '0';
    lightbox.style.visibility = 'hidden';
    lightboxInner.style.transform = 'rotateY(0deg)';
    document.body.style.overflow = '';
  }

  var lightboxContainer = document.getElementById('lightboxCardContainer');
  if (lightboxContainer) {
    lightboxContainer.addEventListener('click', function(e) {
      e.stopPropagation();
      var currentTransform = lightboxInner.style.transform;
      if (currentTransform.indexOf('180deg') > -1) {
        lightboxInner.style.transform = 'rotateY(0deg)';
      } else {
        lightboxInner.style.transform = 'rotateY(180deg) rotate(90deg)';
      }
    });
  }

  if (lightbox) {
    lightbox.addEventListener('click', function(e) {
      if (e.target === lightbox) {
        closeLightbox();
      }
    });
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeLightbox();
    }
  });
})();
</script>

{% schema %}
{
  "name": "Interactive Cards",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag",
      "default": "Try It Out"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Experience Prayer Portals"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Drag the cards around. Click one to flip it over and see how it works."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "text",
          "id": "card_name",
          "label": "Card name",
          "default": "Anxious"
        },
        {
          "type": "image_picker",
          "id": "front_image",
          "label": "Front image"
        },
        {
          "type": "image_picker",
          "id": "back_image",
          "label": "Back image"
        },
        {
          "type": "range",
          "id": "position_x",
          "label": "Position X",
          "min": 0,
          "max": 70,
          "default": 10,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "position_y",
          "label": "Position Y",
          "min": 0,
          "max": 60,
          "default": 15,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "rotation",
          "label": "Rotation",
          "min": -15,
          "max": 15,
          "default": 0,
          "unit": "deg"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Interactive Cards",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "card_name": "Anxious",
            "position_x": 10,
            "position_y": 15,
            "rotation": -8
          }
        },
        {
          "type": "card",
          "settings": {
            "card_name": "Grateful",
            "position_x": 38,
            "position_y": 25,
            "rotation": 3
          }
        },
        {
          "type": "card",
          "settings": {
            "card_name": "Lonely",
            "position_x": 65,
            "position_y": 10,
            "rotation": -4
          }
        }
      ]
    }
  ]
}
{% endschema %}
