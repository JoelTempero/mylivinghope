{% comment %}
  Interactive Prayer Cards Section
  Horizontal cards that flip to vertical in place
{% endcomment %}

<style>
.interactive-cards-section {
  padding: 6rem 0;
  overflow: hidden;
}

.interactive-cards__container {
  position: relative;
  height: 450px;
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 0 2rem;
}

.prayer-card {
  position: relative;
  width: 420px;
  height: 300px;
  cursor: grab;
  perspective: 1000px;
  user-select: none;
  flex-shrink: 0;
}

.prayer-card:active {
  cursor: grabbing;
}

.prayer-card__inner {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transition: transform 0.6s ease;
  border-radius: 16px;
  box-shadow: 0 10px 30px rgba(33, 32, 33, 0.2);
}

.prayer-card--flipped .prayer-card__inner {
  transform: rotateY(180deg) rotate(-90deg);
}

.prayer-card__front,
.prayer-card__back {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: 16px;
  overflow: hidden;
  background: var(--soft-blush, #F5D7CF);
}

.prayer-card__front img,
.prayer-card__back img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.prayer-card__back {
  transform: rotateY(180deg);
  background: var(--forest-green, #336F49);
}

.prayer-card__placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-heading, 'Libre Baskerville', serif);
  font-size: 1.5rem;
  padding: 1.5rem;
  text-align: center;
}

.prayer-card__front .prayer-card__placeholder {
  color: var(--charcoal, #212021);
  background: linear-gradient(135deg, #F5D7CF 0%, #E8C4BA 100%);
}

.prayer-card__back .prayer-card__placeholder {
  color: white;
  background: linear-gradient(135deg, #336F49 0%, #265438 100%);
  font-size: 1.25rem;
}

.interactive-cards__hint {
  text-align: center;
  margin-top: 2rem;
  color: var(--text-muted, #8a8788);
  font-size: 0.9375rem;
}

/* Responsive adjustments */
@media (max-width: 1200px) {
  .interactive-cards__container {
    flex-wrap: wrap;
    height: auto;
    gap: 2rem;
    padding: 2rem;
  }
  
  .prayer-card {
    width: 340px;
    height: 240px;
  }
}

@media (max-width: 768px) {
  .interactive-cards__container {
    flex-direction: column;
    align-items: center;
  }
  
  .prayer-card {
    width: 300px;
    height: 210px;
  }
}
</style>

<section class="section interactive-cards-section" id="try-cards">
  <div class="container">
    <header class="section-header">
      <span class="section-tag">{{ section.settings.tag }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p style="color: var(--text-muted);">{{ section.settings.description }}</p>
    </header>

    <div class="interactive-cards__container" id="cardsContainer">
      {% assign card_names = "Anxious,Grateful,Lonely" | split: "," %}
      {% for i in (1..3) %}
        {% assign block = section.blocks[forloop.index0] %}
        {% assign default_name = card_names[forloop.index0] %}
        <div class="prayer-card" data-index="{{ forloop.index }}">
          <div class="prayer-card__inner">
            <div class="prayer-card__front">
              {% if block.settings.front_image %}
                <img 
                  src="{{ block.settings.front_image | image_url: width: 840 }}" 
                  alt="{{ block.settings.card_name | default: default_name }} - Front" 
                  draggable="false"
                >
              {% else %}
                <div class="prayer-card__placeholder">
                  {{ block.settings.card_name | default: default_name }}
                </div>
              {% endif %}
            </div>
            <div class="prayer-card__back">
              {% if block.settings.back_image %}
                <img 
                  src="{{ block.settings.back_image | image_url: width: 840 }}" 
                  alt="{{ block.settings.card_name | default: default_name }} - Scripture" 
                  draggable="false"
                >
              {% else %}
                <div class="prayer-card__placeholder">
                  Scripture &amp; Prayer for {{ block.settings.card_name | default: default_name }}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <p class="interactive-cards__hint">
      {{ section.settings.hint_text }}
    </p>
  </div>
</section>

<script>
(function() {
  var cards = document.querySelectorAll('.prayer-card');
  if (!cards.length) return;

  var isDragging = false;
  var currentCard = null;
  var startX = 0;
  var startY = 0;
  var initialLeft = 0;
  var initialTop = 0;
  var hasMoved = false;
  var highestZ = 10;

  for (var i = 0; i < cards.length; i++) {
    cards[i].style.zIndex = i + 1;
    cards[i].addEventListener('mousedown', startDrag);
    cards[i].addEventListener('touchstart', startDrag);
  }

  function startDrag(e) {
    currentCard = this;
    isDragging = true;
    hasMoved = false;

    highestZ = highestZ + 1;
    currentCard.style.zIndex = highestZ;

    if (e.type === 'touchstart') {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
    } else {
      startX = e.clientX;
      startY = e.clientY;
    }

    var transform = window.getComputedStyle(currentCard).transform;
    var matrix = new DOMMatrix(transform);
    initialLeft = matrix.m41;
    initialTop = matrix.m42;

    currentCard.style.cursor = 'grabbing';
    currentCard.style.transition = 'none';

    document.addEventListener('mousemove', drag);
    document.addEventListener('mouseup', endDrag);
    document.addEventListener('touchmove', drag, { passive: false });
    document.addEventListener('touchend', endDrag);

    e.preventDefault();
  }

  function drag(e) {
    if (!isDragging || !currentCard) return;

    var clientX = 0;
    var clientY = 0;

    if (e.type === 'touchmove') {
      clientX = e.touches[0].clientX;
      clientY = e.touches[0].clientY;
      e.preventDefault();
    } else {
      clientX = e.clientX;
      clientY = e.clientY;
    }

    var deltaX = clientX - startX;
    var deltaY = clientY - startY;

    if (Math.abs(deltaX) > 5 || Math.abs(deltaY) > 5) {
      hasMoved = true;
    }

    var newX = initialLeft + deltaX;
    var newY = initialTop + deltaY;

    currentCard.style.transform = 'translate(' + newX + 'px, ' + newY + 'px)';
  }

  function endDrag(e) {
    if (!currentCard) return;

    document.removeEventListener('mousemove', drag);
    document.removeEventListener('mouseup', endDrag);
    document.removeEventListener('touchmove', drag);
    document.removeEventListener('touchend', endDrag);

    currentCard.style.cursor = 'grab';
    currentCard.style.transition = '';

    if (!hasMoved) {
      currentCard.classList.toggle('prayer-card--flipped');
    }

    isDragging = false;
    currentCard = null;
  }
})();
</script>

{% schema %}
{
  "name": "Interactive Cards",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag",
      "default": "Try It Out"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Experience Prayer Portals"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Drag the cards around. Click one to flip it over and see how it works."
    },
    {
      "type": "text",
      "id": "hint_text",
      "label": "Hint text",
      "default": "Drag cards to move them • Click to flip and reveal Scripture"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "card_name",
          "label": "Card name",
          "default": "Emotion"
        },
        {
          "type": "image_picker",
          "id": "front_image",
          "label": "Front image (horizontal)"
        },
        {
          "type": "image_picker",
          "id": "back_image",
          "label": "Back image (horizontal)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Interactive Cards",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "card_name": "Anxious"
          }
        },
        {
          "type": "card",
          "settings": {
            "card_name": "Grateful"
          }
        },
        {
          "type": "card",
          "settings": {
            "card_name": "Lonely"
          }
        }
      ]
    }
  ]
}
{% endschema %}
