{% comment %}
  Featured Products Section - Proper product cards with all info
{% endcomment %}

<style>
.featured-products {
  padding: 3rem 0;
}

@media (min-width: 768px) {
  .featured-products {
    padding: 6rem 0;
  }
}

.featured-products__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
  max-width: 1200px;
  margin: 0 auto;
}

@media (min-width: 640px) {
  .featured-products__grid {
    gap: 1.5rem;
  }
}

@media (min-width: 900px) {
  .featured-products__grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
}

.product-card {
  background: var(--white, #fff);
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 4px 6px rgba(33, 32, 33, 0.07);
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
}

.product-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 20px 40px rgba(33, 32, 33, 0.12);
}

.product-card__image-wrapper {
  position: relative;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background: var(--blush-light, #FBE9E4);
}

.product-card__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.product-card:hover .product-card__image {
  transform: scale(1.05);
}

.product-card__badge {
  position: absolute;
  top: 0.5rem;
  left: 0.5rem;
  background: var(--forest-green, #336F49);
  color: white;
  padding: 0.25rem 0.5rem;
  border-radius: 50px;
  font-size: 0.65rem;
  font-weight: 600;
  z-index: 2;
}

@media (min-width: 640px) {
  .product-card__badge {
    top: 1rem;
    left: 1rem;
    padding: 0.375rem 0.875rem;
    font-size: 0.75rem;
  }
}

.product-card__badge--sale {
  background: var(--charcoal, #212021);
}

.product-card__content {
  padding: 1rem;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

@media (min-width: 640px) {
  .product-card__content {
    padding: 1.5rem;
  }
}

.product-card__title {
  font-family: var(--font-heading, 'Libre Baskerville', serif);
  font-size: 1rem;
  font-weight: 700;
  color: var(--charcoal, #212021);
  margin-bottom: 0.25rem;
  line-height: 1.3;
}

@media (min-width: 640px) {
  .product-card__title {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }
}

.product-card__title a {
  color: inherit;
  text-decoration: none;
}

.product-card__title a:hover {
  color: var(--forest-green, #336F49);
}

.product-card__description {
  font-size: 0.875rem;
  color: var(--text-muted, #8a8788);
  line-height: 1.5;
  margin-bottom: 0.75rem;
  flex-grow: 1;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Hide description on small mobile */
@media (max-width: 479px) {
  .product-card__description {
    display: none;
  }
}

@media (min-width: 640px) {
  .product-card__description {
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }
}

.product-card__pricing {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 0.75rem;
  margin-top: auto;
}

@media (min-width: 640px) {
  .product-card__pricing {
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
}

.product-card__price {
  font-family: var(--font-heading, 'Libre Baskerville', serif);
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--charcoal, #212021);
}

@media (min-width: 640px) {
  .product-card__price {
    font-size: 1.5rem;
  }
}

.product-card__price-compare {
  font-size: 1rem;
  color: var(--text-muted, #8a8788);
  text-decoration: line-through;
}

.product-card__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.625rem 1rem;
  background: var(--forest-green, #336F49);
  color: white;
  font-family: var(--font-body, 'Montserrat', sans-serif);
  font-size: 0.8125rem;
  font-weight: 600;
  text-decoration: none;
  border: 2px solid var(--forest-green, #336F49);
  border-radius: 50px;
  cursor: pointer;
  transition: all 0.25s ease;
  width: 100%;
}

@media (min-width: 640px) {
  .product-card__btn {
    padding: 0.875rem 1.5rem;
    font-size: 0.9375rem;
  }
}

.product-card__btn:hover {
  background: var(--green-dark, #265438);
  border-color: var(--green-dark, #265438);
  transform: translateY(-2px);
}

.product-card__btn svg {
  width: 18px;
  height: 18px;
  transition: transform 0.2s ease;
}

.product-card__btn:hover svg {
  transform: translateX(3px);
}

/* Empty state */
.featured-products__empty {
  text-align: center;
  padding: 4rem 2rem;
  color: var(--text-muted, #8a8788);
}
</style>

<section class="section featured-products" id="products">
  <div class="container">
    <header class="section-header">
      <span class="section-tag">{{ section.settings.tag | default: "Our Collection" }}</span>
      <h2>{{ section.settings.heading | default: "Prayer Card Sets" }}</h2>
      <p style="color: var(--text-muted);">{{ section.settings.description | default: "Beautiful, practical tools for your spiritual journey" }}</p>
    </header>

    <div class="featured-products__grid">
      {% if section.settings.collection != blank and section.settings.collection.products.size > 0 %}
        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
          <article class="product-card">
            {% if product.compare_at_price > product.price %}
              <span class="product-card__badge product-card__badge--sale">
                Save {{ product.compare_at_price | minus: product.price | money }}
              </span>
            {% elsif product.tags contains 'best-seller' %}
              <span class="product-card__badge">Best Seller</span>
            {% elsif product.tags contains 'new' %}
              <span class="product-card__badge">New</span>
            {% endif %}

            <a href="{{ product.url }}" class="product-card__image-wrapper">
              {% if product.featured_image %}
                <img 
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | default: product.title }}"
                  class="product-card__image"
                  width="600"
                  height="600"
                  loading="lazy"
                >
              {% else %}
                <div style="width:100%;height:100%;background:var(--blush-light);display:flex;align-items:center;justify-content:center;color:var(--text-muted);">No image</div>
              {% endif %}
            </a>

            <div class="product-card__content">
              <h3 class="product-card__title">
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>
              
              <p class="product-card__description">
                {{ product.description | strip_html | truncate: 100 }}
              </p>
              
              <div class="product-card__pricing">
                <span class="product-card__price">{{ product.price | money }}</span>
                {% if product.compare_at_price > product.price %}
                  <span class="product-card__price-compare">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </div>

              <a href="{{ product.url }}" class="product-card__btn">
                View Product
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </article>
        {% endfor %}
      {% else %}
        <!-- Fallback: Show placeholder cards when no collection selected -->
        {% for i in (1..3) %}
          <article class="product-card">
            <div class="product-card__image-wrapper">
              <div style="width:100%;height:100%;background:linear-gradient(135deg, var(--blush-light, #FBE9E4) 0%, var(--soft-blush, #F5D7CF) 100%);display:flex;align-items:center;justify-content:center;color:var(--text-muted, #8a8788);font-size:0.875rem;">
                Select a collection
              </div>
            </div>
            <div class="product-card__content">
              <h3 class="product-card__title">Product Title</h3>
              <p class="product-card__description">
                Product description will appear here once you select a collection in the section settings.
              </p>
              <div class="product-card__pricing">
                <span class="product-card__price">$0.00</span>
              </div>
              <span class="product-card__btn">View Product</span>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Section tag",
      "default": "Our Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Prayer Card Sets"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Beautiful, practical tools for your spiritual journey"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}
