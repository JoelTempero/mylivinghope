{% comment %}
  Featured Products Section
{% endcomment %}

<section class="section" id="products">
  <div class="container">
    <header class="section-header reveal">
      <span class="section-tag">{{ section.settings.tag | default: "Our Collection" }}</span>
      <h2>{{ section.settings.heading | default: "Prayer Card Sets" }}</h2>
      <p>{{ section.settings.description | default: "Beautiful, practical tools for your spiritual journey" }}</p>
    </header>

    <div class="products__grid">
      {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
        <article class="product-card reveal reveal--delay-{{ forloop.index }}">
          {% if product.compare_at_price > product.price %}
            <span class="product-card__badge product-card__badge--sale">
              Save {{ product.compare_at_price | minus: product.price | money }}
            </span>
          {% elsif product.tags contains 'best-value' %}
            <span class="product-card__badge">Best Value</span>
          {% endif %}

          <a href="{{ product.url }}" class="product-card__image-wrapper">
            {% if product.featured_image %}
              <img 
                src="{{ product.featured_image | image_url: width: 800 }}"
                alt="{{ product.featured_image.alt | default: product.title }}"
                class="product-card__image"
                width="800"
                height="600"
                loading="lazy"
              >
            {% endif %}
          </a>

          <div class="product-card__content">
            <h3 class="product-card__title">
              <a href="{{ product.url }}">{{ product.title }}</a>
            </h3>
            <p class="product-card__description">{{ product.description | strip_html | truncate: 120 }}</p>
            
            <div class="product-card__pricing">
              <span class="product-card__price">{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}
                <span class="product-card__price-old">{{ product.compare_at_price | money }}</span>
              {% endif %}
            </div>

            <a href="{{ product.url }}" class="btn btn--primary product-card__btn">View Product</a>
          </div>
        </article>
      {% else %}
        {% for i in (1..3) %}
          <article class="product-card reveal reveal--delay-{{ i }}">
            <div class="product-card__image-wrapper" style="background: var(--blush-light);"></div>
            <div class="product-card__content">
              <h3 class="product-card__title">Sample Product {{ i }}</h3>
              <p class="product-card__description">Add products to your collection to see them here.</p>
              <div class="product-card__pricing">
                <span class="product-card__price">$25.00</span>
              </div>
              <span class="btn btn--primary product-card__btn">View Product</span>
            </div>
          </article>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "class": "featured-products-section",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Section tag",
      "default": "Our Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Prayer Card Sets"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Beautiful, practical tools for your spiritual journey"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}
