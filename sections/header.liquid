{% comment %}
  Header Section - Green background with logo icon only
{% endcomment %}

<header class="header">
  <div class="header__inner">
    <a href="{{ routes.root_url }}" class="header__logo" aria-label="{{ shop.name }} - Home">
      {% if section.settings.logo %}
        <img 
          src="{{ section.settings.logo | image_url: width: 100 }}" 
          alt="{{ shop.name }}" 
          width="50" 
          height="50"
          loading="eager"
        >
      {% else %}
        <img 
          src="{{ 'logo.png' | asset_url }}" 
          alt="{{ shop.name }}" 
          width="50" 
          height="50"
          loading="eager"
        >
      {% endif %}
    </a>

    <nav>
      <ul class="header__nav" role="menubar">
        {% for link in section.settings.menu.links %}
          <li role="none">
            <a href="{{ link.url }}" class="header__nav-link{% if link.active %} header__nav-link--active{% endif %}" role="menuitem">
              {{ link.title }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </nav>

    <div class="header__actions">
      <a href="{{ routes.cart_url }}" class="header__cart" aria-label="Cart ({{ cart.item_count }} items)">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="9" cy="21" r="1"/>
          <circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        {% if cart.item_count > 0 %}
          <span class="header__cart-count">{{ cart.item_count }}</span>
        {% endif %}
      </a>

      <a href="{{ routes.all_products_collection_url }}" class="btn btn--small header__cta">
        Shop Now
      </a>

      <button class="header__toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Menu -->
<div class="mobile-menu" id="mobileMenu" aria-hidden="true">
  <ul class="mobile-menu__list">
    {% for link in section.settings.menu.links %}
      <li>
        <a href="{{ link.url }}" class="mobile-menu__link">{{ link.title }}</a>
      </li>
    {% endfor %}
  </ul>
  <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary btn--large">Shop Now</a>
</div>

{% schema %}
{
  "name": "Header",
  "class": "header-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
