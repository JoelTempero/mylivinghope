{% comment %}
  Product Template - Individual Product Page
{% endcomment %}

<style>
.product-page {
  padding: 2rem 0 4rem;
}

@media (min-width: 768px) {
  .product-page {
    padding: 3rem 0 5rem;
  }
}

.product-page__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2rem;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 5%;
}

@media (min-width: 768px) {
  .product-page__grid {
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }
}

@media (min-width: 1024px) {
  .product-page__grid {
    gap: 4rem;
  }
}

/* Gallery */
.product-gallery {
  position: relative;
}

@media (min-width: 768px) {
  .product-gallery {
    position: sticky;
    top: 100px;
  }
}

.product-gallery__main {
  width: 100%;
  border-radius: 16px;
  overflow: hidden;
  background: #FBE9E4;
  margin-bottom: 1rem;
}

.product-gallery__main img {
  width: 100%;
  height: auto;
  display: block;
}

.product-gallery__thumbs {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.product-gallery__thumb {
  width: 60px;
  height: 60px;
  border-radius: 8px;
  overflow: hidden;
  cursor: pointer;
  border: 2px solid transparent;
  transition: border-color 0.2s ease;
  background: none;
  padding: 0;
}

@media (min-width: 640px) {
  .product-gallery__thumb {
    width: 80px;
    height: 80px;
  }
}

.product-gallery__thumb--active,
.product-gallery__thumb:hover {
  border-color: #336F49;
}

.product-gallery__thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Product Info */
.product-info {
  padding: 0;
}

@media (min-width: 768px) {
  .product-info {
    padding: 1rem 0;
  }
}

.product-info__title {
  font-family: var(--font-heading, 'Libre Baskerville', serif);
  font-size: clamp(1.5rem, 4vw, 2.5rem);
  font-weight: 700;
  color: #212021;
  margin: 0 0 1rem 0;
  line-height: 1.2;
}

.product-info__price {
  font-family: var(--font-heading, 'Libre Baskerville', serif);
  font-size: 1.75rem;
  font-weight: 700;
  color: #336F49;
  margin-bottom: 1.5rem;
}

@media (min-width: 768px) {
  .product-info__price {
    font-size: 2rem;
  }
}

.product-info__price-compare {
  font-size: 1.125rem;
  color: #8a8788;
  text-decoration: line-through;
  margin-left: 0.75rem;
  font-weight: 400;
}

.product-info__badge {
  display: inline-block;
  background: #212021;
  color: #fff;
  padding: 0.375rem 1rem;
  border-radius: 50px;
  font-size: 0.8rem;
  font-weight: 600;
  margin-bottom: 1.5rem;
}

.product-info__description {
  font-size: 1rem;
  line-height: 1.8;
  color: #5a5758;
  margin-bottom: 2rem;
}

.product-info__description p {
  margin-bottom: 1rem;
}

.product-info__description p:last-child {
  margin-bottom: 0;
}

/* Product Form */
.product-form {
  border-top: 1px solid #E8C4BA;
  padding-top: 1.5rem;
  margin-top: 0.5rem;
}

.product-form__quantity {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.product-form__quantity label {
  font-weight: 600;
  font-size: 0.9rem;
  color: #212021;
}

.product-form__quantity-input {
  width: 80px;
  padding: 0.75rem 1rem;
  border: 2px solid #E8C4BA;
  border-radius: 8px;
  font-size: 1rem;
  text-align: center;
  background: #fff;
}

.product-form__quantity-input:focus {
  outline: none;
  border-color: #336F49;
}

.product-form__submit {
  width: 100%;
  padding: 1rem 2rem;
  background: #336F49;
  color: #fff;
  font-family: var(--font-body, 'Montserrat', sans-serif);
  font-size: 1rem;
  font-weight: 600;
  border: 2px solid #336F49;
  border-radius: 50px;
  cursor: pointer;
  transition: all 0.25s ease;
}

.product-form__submit:hover:not(:disabled) {
  background: #265438;
  border-color: #265438;
  transform: translateY(-2px);
}

.product-form__submit:disabled {
  background: #8a8788;
  border-color: #8a8788;
  cursor: not-allowed;
}

/* Features list */
.product-features {
  margin-top: 2rem;
  padding-top: 1.5rem;
  border-top: 1px solid #E8C4BA;
}

.product-features__title {
  font-family: var(--font-heading, 'Libre Baskerville', serif);
  font-size: 1.125rem;
  font-weight: 700;
  color: #212021;
  margin-bottom: 1rem;
}

.product-features__list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.product-features__item {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  padding: 0.5rem 0;
  font-size: 0.9375rem;
  color: #5a5758;
}

.product-features__icon {
  color: #336F49;
  flex-shrink: 0;
  margin-top: 2px;
}
</style>

<div class="product-page">
  <div class="product-page__grid">
    <!-- Gallery -->
    <div class="product-gallery">
      <div class="product-gallery__main">
        {% if product.featured_image %}
          <img
            src="{{ product.featured_image | image_url: width: 800 }}"
            alt="{{ product.featured_image.alt | default: product.title }}"
            id="mainProductImage"
            width="800"
            height="800"
          >
        {% endif %}
      </div>

      {% if product.images.size > 1 %}
        <div class="product-gallery__thumbs">
          {% for image in product.images %}
            <button
              class="product-gallery__thumb{% if forloop.first %} product-gallery__thumb--active{% endif %}"
              data-image-url="{{ image | image_url: width: 800 }}"
              aria-label="View image {{ forloop.index }}"
            >
              <img
                src="{{ image | image_url: width: 100 }}"
                alt="{{ image.alt | default: product.title }}"
                width="80"
                height="80"
                loading="lazy"
              >
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- Product Info -->
    <div class="product-info">
      <h1 class="product-info__title">{{ product.title }}</h1>

      {% if product.compare_at_price > product.price %}
        <span class="product-info__badge">
          Save {{ product.compare_at_price | minus: product.price | money }}
        </span>
      {% endif %}

      <p class="product-info__price">
        {{ product.price | money }}
        {% if product.compare_at_price > product.price %}
          <span class="product-info__price-compare">{{ product.compare_at_price | money }}</span>
        {% endif %}
      </p>

      <div class="product-info__description">
        {{ product.description }}
      </div>

      {% form 'product', product, class: 'product-form' %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

        <div class="product-form__quantity">
          <label for="quantity">Quantity</label>
          <input type="number" id="quantity" name="quantity" value="1" min="1" class="product-form__quantity-input">
        </div>

        <button type="submit" class="product-form__submit"{% unless product.available %} disabled{% endunless %}>
          {% if product.available %}
            Add to Cart
          {% else %}
            Sold Out
          {% endif %}
        </button>
      {% endform %}

      <div class="product-features">
        <h3 class="product-features__title">What's Included</h3>
        <ul class="product-features__list">
          <li class="product-features__item">
            <svg class="product-features__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Premium quality cards</span>
          </li>
          <li class="product-features__item">
            <svg class="product-features__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Scripture-based prompts</span>
          </li>
          <li class="product-features__item">
            <svg class="product-features__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Beautiful packaging</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>

<script>
  // Image gallery functionality
  document.querySelectorAll('.product-gallery__thumb').forEach(thumb => {
    thumb.addEventListener('click', function() {
      const mainImage = document.getElementById('mainProductImage');
      mainImage.src = this.dataset.imageUrl;

      document.querySelectorAll('.product-gallery__thumb').forEach(t => t.classList.remove('product-gallery__thumb--active'));
      this.classList.add('product-gallery__thumb--active');
    });
  });
</script>
